{
  "id": "liquid-openclaw-plugin",
  "name": "Liquid Wallet Plugin",
  "description": "Direct integration with Liquid wallet for blockchain operations - get addresses, sign messages, and sign transactions.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "LIQUID_APP_ID": {
        "type": "string",
        "minLength": 1,
        "description": "Application ID from Liquid Portal."
      },
      "LIQUID_CLIENT_ID": {
        "type": "string",
        "minLength": 1,
        "description": "Legacy alias for LIQUID_APP_ID."
      },
      "LIQUID_CLIENT_SECRET": {
        "type": "string",
        "minLength": 1,
        "description": "Optional client secret for confidential clients."
      },
      "LIQUID_AUTH_BASE_URL": {
        "type": "string",
        "minLength": 1
      },
      "LIQUID_CONNECT_BASE_URL": {
        "type": "string",
        "minLength": 1
      },
      "LIQUID_API_BASE_URL": {
        "type": "string",
        "minLength": 1
      },
      "LIQUID_CALLBACK_PORT": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "LIQUID_CALLBACK_PATH": {
        "type": "string",
        "minLength": 1
      },
      "LIQUID_SSO_PROVIDER": {
        "type": "string",
        "minLength": 1
      },
      "LIQUID_MCP_DEBUG": {
        "type": "string"
      }
    }
  },
  "uiHints": {
    "LIQUID_APP_ID": {
      "label": "Liquid App ID",
      "placeholder": "your_app_id_from_portal"
    },
    "LIQUID_CLIENT_SECRET": {
      "label": "Liquid Client Secret",
      "sensitive": true
    },
    "LIQUID_CALLBACK_PORT": {
      "label": "Callback Port",
      "placeholder": "8080"
    },
    "LIQUID_MCP_DEBUG": {
      "label": "Enable Debug Logging",
      "placeholder": "1"
    }
  }
}
